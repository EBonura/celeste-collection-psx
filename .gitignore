# Rust build output (each game is its own workspace)
target/
**/target/

# Disc / EXE build artifacts
/build/
*.exe
*.bin
*.cue
*.toc
# Headless navigation route output (tools/nav_routes.py)
/dist/nav-routes/

# itch.io release artifacts -- pushed to itch via butler, so the disc image in
# release/ must be tracked despite the *.bin / *.cue ignores above.
!/release/*.bin
!/release/*.cue
!/release/*.txt

# Reference audio captures (regenerable from the carts via tools/record_pico8_sfx.py)
audio-ref/
*.wav

# AI agent / editor scratch (kept local, never committed)
CLAUDE.md
AGENTS.md
.claude/
.codex/
.cursor/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Imported by tools/bootstrap-components.py from components.lock.json. Never
# committed: the lock is the source of truth, this is a cache.
.psoxide/
# The emulator, cloned by `make emulator` at the revision pinned in the Makefile.
.psoxide-emulator/

# Reference audio may also be a symlink into another checkout
audio-ref
tools/psx-audio-capture/Cargo.lock
